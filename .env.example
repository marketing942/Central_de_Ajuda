# Todas as variáveis que o código lê. Ao adicionar uma nova no código,
# adicione aqui e no compose.yml — o que não está listado lá não chega ao
# container.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://central-de-ajuda.cppem.com.br
# Link "Voltar para cppem.com.br" no cabeçalho e rodapé.
CPPEM_SITE_URL=https://cppem.com.br

# ---------------------------------------------------------------------------
# Notion
#
# A integração do NOTION_TOKEN precisa estar conectada à página
# "CENTRAL DE AJUDA" no Notion (••• → Conexões → adicionar). Sem isso a API
# responde "object_not_found" e a central aparece vazia, sem erro na tela.
# ---------------------------------------------------------------------------
NOTION_TOKEN=
# Database "💬 Central de Ajuda — CPPEM"
NOTION_AJUDA_DATABASE_ID=3e2bbae8074c8003ad8bda3d0b74a9b7

# Protege POST /api/revalidate (publicação imediata, sem esperar os 5 min de cache).
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Atendimento
# Os dois canais de WhatsApp (assistente IA 24h e equipe 12h–22h em dias úteis) ficam em
# lib/contact.ts e apontam para links.cppem.com.br. Opcional: e-mail extra.
# ---------------------------------------------------------------------------
SUPORTE_EMAIL=
